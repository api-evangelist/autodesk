{
  "opencollection": "1.0.0",
  "info": {
    "name": "Autodesk ACC Account Admin Account Users Keys API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://developer.api.autodesk.com/authentication/v2/authorize",
      "accessTokenUrl": "https://developer.api.autodesk.com/authentication/v2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Autodesk Get JWKS",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://developer.api.autodesk.com/authentication/v2/keys"
          },
          "docs": "Returns the JSON Web Key Set (JWKS) containing the public keys used to verify JSON Web Tokens (JWTs) issued by the Autodesk authentication service."
        }
      ]
    }
  ],
  "bundled": true
}