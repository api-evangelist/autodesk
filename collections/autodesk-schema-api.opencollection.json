{
  "opencollection": "1.0.0",
  "info": {
    "name": "Autodesk ACC Account Admin Account Users Schema API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://developer.api.autodesk.com/authentication/v2/authorize",
      "accessTokenUrl": "https://developer.api.autodesk.com/authentication/v2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Schema",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Autodesk Get Twin Schema",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://developer.api.autodesk.com/tandem/v1/twins/:twinId/schema",
            "params": [
              {
                "name": "twinId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the schema definition for a digital twin, including built-in and custom property definitions."
        }
      ]
    }
  ],
  "bundled": true
}