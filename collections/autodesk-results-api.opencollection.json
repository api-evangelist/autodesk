{
  "opencollection": "1.0.0",
  "info": {
    "name": "Autodesk ACC Account Admin Account Users Results API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://developer.api.autodesk.com/authentication/v2/authorize",
      "accessTokenUrl": "https://developer.api.autodesk.com/authentication/v2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Results",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Photoscene Result",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://developer.api.autodesk.com/photo-to-3d/v1/photoscene/:photosceneid?format=:format",
            "params": [
              {
                "name": "photosceneid",
                "value": "",
                "type": "path"
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Output format for the result."
              }
            ]
          },
          "docs": "Returns a download link for the processed result in the specified format. The result must be ready (processing complete) before downloading."
        }
      ]
    }
  ],
  "bundled": true
}