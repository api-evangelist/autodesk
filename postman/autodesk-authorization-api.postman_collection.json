                  "name": "Autodesk Authorize User",
                  "id": "c4dfd49d-a69e-4abd-b0a4-97e7a48a78a0",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "GET",
                    "header": [],
                    "url": {
                      "raw": "{{baseUrl}}/authentication/v2/authorize?response_type=code&client_id=<string>&redirect_uri=<uri>&scope=<string>&state=<string>&nonce=<string>&prompt=login",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "authentication",
                        "v2",
                        "authorize"
                      ],
                      "query": [
                        {
                          "description": "(Required) Must be set to `code` for authorization code flow.",
                          "key": "response_type",
                          "value": "code"
                        },
                        {
                          "description": "(Required) The Client ID of your APS application.",
                          "key": "client_id",
                          "value": "<string>"
                        },
                        {
                          "description": "(Required) The URI that Autodesk redirects the user to after granting consent. Must match a redirect URI registered with the application.",
                          "key": "redirect_uri",
                          "value": "<uri>"
                        },
                        {
                          "description": "(Required) Space-separated list of scopes requested. Common scopes include data:read, data:write, data:create, account:read, account:write.",
                          "key": "scope",
                          "value": "<string>"
                        },
                        {
                          "description": "An opaque value that the application uses to maintain state between the request and callback. Used to prevent CSRF attacks.",
                          "key": "state",
                          "value": "<string>"
                        },
                        {
                          "description": "A random string used to associate a client session with an ID token.",
                          "key": "nonce",
                          "value": "<string>"
                        },
                        {
                          "description": "Controls the authentication experience presented to the user.",
                          "key": "prompt",
                          "value": "login"
                        }
                      ]
                    },
                    "description": "Redirects the user to the Autodesk login page where they grant your application access to their data. This is the first step of the three-legged OAuth flow. After the user grants consent, Autodesk redirects them back to the redirect URI with an authorization code."
                  },
                  "response": [
